# .env.production.example — plantilla de producción.
# Copiar a .env.production y completar. NUNCA commitear el .env.production real.
# En Azure, lo ideal es cargar los secretos desde Key Vault (AZURE_VAULT_URL).

# ── App ──────────────────────────────
APP_NAME=DBA Assistant
APP_VERSION=1.0.0
ENVIRONMENT=production
DEBUG=False
ROOT_PATH=/api
CORS_ORIGINS=https://tu-dominio.com

# Generar uno fuerte: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=

# ── Bases de datos ───────────────────
# Producción recomendada: servicios gestionados de Azure.
#   SQL  → Azure SQL Database     MONGO → Cosmos DB for MongoDB     REDIS → Azure Cache for Redis
SQL_SERVER_HOST=
SQL_SERVER_PORT=1433
SQL_SERVER_USER=
SQL_SERVER_PASSWORD=
SQL_SERVER_DATABASE=DBAAssistant

MONGODB_URI=
MONGODB_DATABASE=dba_assistant

REDIS_URL=

# ── Autenticación (Auth0, tenant/app de producción) ──
AUTH_MODE=auth0
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_AUDIENCE=https://dba-assistant-api
# (En SPA no se usa el secret; el backend valida contra el JWKS.)
AUTH0_CLIENT_SECRET=

# ── Claude ───────────────────────────
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022
CLAUDE_MAX_TOKENS=1024

# ── Azure Key Vault (opcional) ───────
# Si se define, el backend hidrata sus variables desde el Vault al arrancar.
# Requiere: pip install -r backend/requirements-azure.txt
# Nombres de secretos con guiones, ej.: SQL-SERVER-PASSWORD, ANTHROPIC-API-KEY
AZURE_VAULT_URL=
