# ── Secretos / Entorno ─────────────────────────
# NUNCA subir archivos .env reales (SA password, API keys, secretos de prod)
.env
.env.*
*.env
backend/.env
# ...pero SÍ versionar las plantillas de ejemplo:
!.env.example
!*.env.example
!.env.production.example
!env.example.txt

# ── Python ─────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Entornos virtuales
.venv/
venv/
env/
ENV/

# Testing / cobertura
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# ── Node / Frontend (sprints futuros) ──────────
node_modules/
npm-debug.log*
yarn-error.log*

# ── Docker ─────────────────────────────────────
# (los volúmenes viven en el daemon, no en el repo; nada que ignorar aquí
#  salvo overrides locales)
docker-compose.override.yml

# ── IDE / Editor ───────────────────────────────
.vscode/
.idea/
*.swp
*~

# ── Sistema operativo ──────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Logs / temporales ──────────────────────────
*.log
logs/
*.tmp
